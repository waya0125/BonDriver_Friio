[FRIIO]
; 使用する機種: auto / ut100b / u3s（既定 auto）
Model=auto

; 同じ機種を複数接続している場合の使う台
;   -1 : 空きデバイス自動選択（他のアプリが使っていない最初の台を開く、既定）
;   0〜: 指定の台に固定（0 始まり）。その台が使用中なら他の台にはずらさず失敗します
; 台の並びは Windows のデバイスパス順で、使用中の台も数えます
DeviceIndex=-1

; 内蔵 B-CAS スロットで ARIB STD-B25 復号を行う（1=有効 / 0=無効、既定 1）
; ※QRS-UT100B・MonsterTV U3S 両対応。外付け PC/SC リーダーを使う場合は 0 に設定
EnableB25=1

; 選局直後の安定化フィルター（Settler）および B25 初期鍵待ちの頭切りを無効化する場合は 1
NoSettle=0

; QRS-UT100B 自動ファームウェア転送用（省略時は DLL と同じフォルダの asv5211-firmware.bin）
; FirmwarePath=asv5211-firmware.bin
; 起動アドレス（通常版 0x5399 = 21401、forNetbook 版 0x53e4 = 21476）
FirmwareIndex=21401

; ------------------------------------------------------------------------------
; MonsterTV U3S 用 衛星（BS / CS110）選局表の上書き（省略時は組み込みの既定表を使用）
; 空間 0 は常に UHF（13〜62ch）固定で、ここで宣言した空間 0, 1, ... は
; チューニング空間 1, 2, ... として配置されます（BonDriver_U3S.ini 互換・タブ区切り）。
; 周波数番号: 0〜11 = BS01〜BS23、12〜23 = CS2〜CS24（ND02〜ND24）
; ------------------------------------------------------------------------------
; [CHANNEL]
; $BS	0
; $CS110	1
; BS01/TS0 BS朝日	0	0	0	16400
; BS15/TS0 NHK BS	0	1	7	16625
; ND02	1	0	12	24608
